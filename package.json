{
  "name": "mili-edu",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "npm run dev --workspace=apps/web & npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=apps/api",
    "build:web": "npm run build --workspace=apps/web",
    "deploy:web": "npm run deploy --workspace=apps/web",
    "deploy:api": "npm run deploy --workspace=apps/api",
    "db:migrate": "npm run db:migrate --workspace=apps/api",
    "db:seed": "npm run db:seed --workspace=apps/api",
    "clean": "rm -rf node_modules apps/*/node_modules"
  },
  "workspaces": [
    "apps/*"
  ],
  "devDependencies": {
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}